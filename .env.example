# Planning Center API Credentials (PCO Account -> Developer -> Personal Access Tokens)
PCO_CLIENT_ID=your_pco_application_id_here
PCO_SECRET=your_pco_secret_here
PCO_SERVICE_TYPE_ID=your_service_type_id_here

# Google Sheets Configuration
# Path to Google Cloud service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Spreadsheet ID from the Google Sheet URL (between /d/ and /edit)
SPREADSHEET_ID=your_google_spreadsheet_id_here
# Name of the worksheet tab to read/write (e.g. 2026)
WORKSHEET_NAME=2026

ANTHROPIC_API_KEY=